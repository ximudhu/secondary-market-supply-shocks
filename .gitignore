# ── Virtual environments ──────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment secrets ───────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Large raw data (tracked via DVC or external storage instead) ──────────────
data_raw/**/*.csv
data_clean/**/*.csv
# Keep directory stubs so git tracks the folders
!data_raw/.gitkeep
!data_clean/.gitkeep

# ── Python cache & build artefacts ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# ── Jupyter artefacts ────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── macOS system files ────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE / editor configs ──────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Logs & temporary outputs ──────────────────────────────────────────────────
*.log
*.tmp

# ── Raw data files and thumbnail images (Privacy & Repo Size) ─────────────────
data_raw/**/*.csv
data_raw/**/*.png
data_raw/**/*.jpg
data_raw/**/*.jpeg
# Ensure .gitkeep is STILL tracked to preserve directory structure
!data_raw/**/.gitkeep

# ── Private project metadata (contains real IP/product names) ─────────────────
# config_meta.csv — maps anonymised Asset IDs to actual JP product names & dates
config_meta.csv
# HANDOVER.md — internal research notes with actual Japanese IP names
HANDOVER.md
# notes/ — personal reading notes and internal memos, not for public distribution
notes/
